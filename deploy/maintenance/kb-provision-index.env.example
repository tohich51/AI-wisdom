# C15 — environment for the provisioning one-shot. TEMPLATE.
#
# Copy to /etc/kb/kb-provision-index.env on the target host, fill it in, and
# `chmod 0400 root:root`. The filled file is untracked and never in git.
#
# There is no default value for any secret in this file. A `__PLACEHOLDER__`
# that somebody forgets to replace makes the one-shot fail loudly at start-up,
# which is the correct outcome; a working default would be a credential in a
# repository.

# Connection string for the PROVISIONING role, not for postgres and not for
# kb_app. The role is NOSUPERUSER NOBYPASSRLS and holds grants on five tables.
KB_DB_DSN=__PLACEHOLDER__postgresql://kb_provisioner:__PLACEHOLDER__@127.0.0.1:5432/knowledge_hub

# The OpenViking admin endpoint. This creates accounts; the gateway must never
# be given a URL it can reach this one from.
KB_OPENVIKING_ADMIN_URL=__PLACEHOLDER__http://127.0.0.1:19300

# THE ROOT KEY. Account creation only. It is not mounted into the gateway, not
# mounted into the parser and not given to the worker. If you find yourself
# adding it to another service's environment file, stop: that is the failure
# this whole operation exists to prevent.
KB_OPENVIKING_ROOT_KEY=__PLACEHOLDER__

# Where issued service keys are written. Must be writable by UID 1000 inside
# the container; it is the only writable path there.
KB_SECRET_STORE_DIR=/run/kb-secrets
