# Gateway receives only read keys, never provider/admin/index credentials.
KB_SEMANTIC_SEARCH_ENABLED=true
KB_INDEXING_ENABLED=true
KB_OPENVIKING_URL=http://pkb-openviking:1933
KB_READ_KEYS_ROOT=/run/read-keys
# Dedicated kb_provisioner role: not superuser and no BYPASSRLS.
KB_INDEXER_DATABASE_URL=__PRIVATE_DSN__
KB_INDEXER_PRINCIPAL_ID=__MANAGING_PRINCIPAL_UUID__
KB_INDEXER_ACCOUNT_ID=__ORGANISATION_UUID__
KB_OPENVIKING_ROOT_KEY_FILE=/run/secrets/openviking-root
KB_INDEX_KEYS_ROOT=/run/index-keys
KB_BOOTSTRAP_KEYS_ROOT=/run/bootstrap-keys
