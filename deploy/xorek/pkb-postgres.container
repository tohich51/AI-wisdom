[Unit]
Description=AI-wisdom canonical PostgreSQL and separate Keycloak database
After=network-online.target

[Container]
Image=docker.io/library/postgres@sha256:1a66d744c1b459e13b05a8fca341da84cb63383e99ce262210efee5a319d4551
ContainerName=pkb-postgres
Network=pkb.network
EnvironmentFile=%h/ai-wisdom-config/postgres.env
Volume=%h/ai-wisdom-data/postgres:/var/lib/postgresql/data:Z
NoNewPrivileges=true
PodmanArgs=--memory=768m --memory-swap=768m --cpus=1 --pids-limit=256 --network-alias=pkb-postgres
Label=pkb.component=postgres

[Service]
Restart=on-failure
RestartSec=5
MemoryMax=768M
MemorySwapMax=0
CPUQuota=100%
TimeoutStartSec=180

[Install]
WantedBy=default.target
