[Unit]
Description=AI-wisdom OpenViking vector projection
[Container]
Image=localhost/openviking-vectors-only:2f0c5057dd819779333d2df0df1fbdaaca56bf5c
ContainerName=pkb-openviking
Network=pkb.network
PodmanArgs=--network-alias=pkb-openviking --memory=2g --memory-swap=2g --cpus=1.5 --pids-limit=512
Environment=OPENVIKING_WITH_BOT=0
Environment=OPENVIKING_CONFIG_FILE=/etc/openviking/ov.conf
Volume=/home/kb-inspect/ai-wisdom-config/openviking/ov.conf:/etc/openviking/ov.conf:ro
Volume=/home/kb-inspect/ai-wisdom-data/openviking:/data
PublishPort=127.0.0.1:19285:1933
[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=300
[Install]
WantedBy=default.target
