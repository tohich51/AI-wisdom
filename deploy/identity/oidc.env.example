# C07 — gateway identity environment template.
#
# Copy to an untracked file (e.g. deploy/identity/oidc.env on the target host,
# or a Podman EnvironmentFile), fill every __PLACEHOLDER__, and never commit
# the filled copy. The gateway refuses to start while any __PLACEHOLDER__
# remains, so a half-substituted file fails at boot rather than at first login.
#
# Generate the two keys, do not type them:
#   python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"   # KB_IDENTITY_KEY
#   podman run --rm docker.io/keycloak/keycloak:latest kc.sh --help  # then use the admin console
#   python3 -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())" # also valid for KB_IDENTITY_KEY

# ---- provider coordinates (from the realm export) ---------------------------
KB_OIDC_ISSUER=https://idp.example.invalid/realms/knowledge-hub
KB_OIDC_AUDIENCE=kb-gateway
KB_OIDC_CLIENT_ID=kb-gateway
KB_OIDC_CLIENT_SECRET=__KB_OIDC_CLIENT_SECRET__

# Discovery is derived from the issuer when these are empty:
#   {issuer}/.well-known/openid-configuration
# Set them only when a proxy serves the provider on a different path.
#KB_OIDC_DISCOVERY_URL=
#KB_OIDC_JWKS_URL=

# Must be byte-for-byte one of the client's redirectUris in
# realm-knowledge-hub.json. A redirect_uri that the provider does not know is
# rejected by the provider; one the provider knows but the gateway does not
# expect is rejected here.
KB_OIDC_REDIRECT_URI=https://kb.example.invalid/auth/callback
KB_OIDC_POST_LOGOUT_REDIRECT_URI=https://kb.example.invalid/
KB_APP_ROOT_URL=https://kb.example.invalid
KB_APP_ORIGIN=https://kb.example.invalid

KB_OIDC_SCOPES=openid profile email
# Enforced on MCP bearer tokens (C08), not on the browser ID token, which
# carries no scope claim in this profile.
#KB_OIDC_REQUIRED_SCOPES=kb:read kb:contribute kb:experience kb:export

# ---- gateway secrets --------------------------------------------------------
# Fernet key. Seals the in-flight PKCE verifier. Rotating it invalidates every
# pending login (they fail with a clean "start again") and nothing else.
KB_IDENTITY_KEY=__KB_IDENTITY_KEY__

# ---- lifetimes (seconds / minutes / hours) ----------------------------------
KB_OIDC_CLOCK_SKEW_SECONDS=30
KB_SESSION_LOGIN_TTL_MINUTES=10
KB_SESSION_IDLE_MINUTES=30
KB_SESSION_ABSOLUTE_HOURS=12
KB_OIDC_HTTP_TIMEOUT=5

# false is for a local https-less development run only. It also drops the
# __Host- prefix from the cookie names, because that prefix requires Secure.
KB_SESSION_COOKIE_SECURE=true

# ---- mail (realm import only; not read by the gateway) ---------------------
KB_SMTP_HOST=__KB_SMTP_HOST__
KB_SMTP_PORT=587
KB_SMTP_USER=__KB_SMTP_USER__
KB_SMTP_PASSWORD=__KB_SMTP_PASSWORD__
KB_MAIL_FROM=__KB_MAIL_FROM__
KB_MAIL_REPLY_TO=__KB_MAIL_REPLY_TO__
