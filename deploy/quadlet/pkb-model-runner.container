[Unit]
Description=Personal Knowledge Base model runner

[Container]
Image=localhost/ai-wisdom:__RELEASE_SHA__
Network=pkb.network
ReadOnly=true
NoNewPrivileges=true
EnvironmentFile=%h/ai-wisdom-config/model-runner.env
Tmpfs=/tmp:rw,nosuid,nodev,size=128m
ContainerName=pkb-model-runner
Exec=model-runner
PodmanArgs=--network-alias=pkb-model-runner
Volume=%h/.mmx:/home/kb-inspect/.mmx:rw
Volume=%h/.local/bin/node:/home/kb-inspect/.local/bin/node:ro
Volume=%h/.local/bin/mmx-subscription:/home/kb-inspect/.local/bin/mmx-subscription:ro
Volume=%h/.local/share/ai-wisdom-tools:/home/kb-inspect/.local/share/ai-wisdom-tools:ro
Environment=HOME=/home/kb-inspect
Environment=PATH=/home/kb-inspect/.local/bin:/usr/local/bin:/usr/bin:/bin

[Service]
Restart=on-failure
TimeoutStartSec=300
MemoryMax=768M
CPUQuota=50%

[Install]
WantedBy=default.target
